  <!-- The DMA runtime is fetched by scripts/Fetch-MemProcFS.ps1 and is never
       committed: MemProcFS is AGPL-3.0, LeechCore is GPL-3.0, and FTD3XX.dll is
       FTDI proprietary. All five files are required - FTD3XX.dll is imported by
       leechcore.dll, so the backend cannot load without it. -->
  <ItemGroup>
    <DmaRuntime Include="$(ProjectDir)..\ThirdParty\MemProcFS\bin\vmm.dll" Condition="Exists('$(ProjectDir)..\ThirdParty\MemProcFS\bin\vmm.dll')" />
    <DmaRuntime Include="$(ProjectDir)..\ThirdParty\MemProcFS\bin\leechcore.dll" Condition="Exists('$(ProjectDir)..\ThirdParty\MemProcFS\bin\leechcore.dll')" />
    <DmaRuntime Include="$(ProjectDir)..\ThirdParty\MemProcFS\bin\FTD3XX.dll" Condition="Exists('$(ProjectDir)..\ThirdParty\MemProcFS\bin\FTD3XX.dll')" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\config.ini" />
  </ItemGroup>
  <Target Name="RequireX64" BeforeTargets="PrepareForBuild" Condition="'$(Platform)'!='x64'">
    <Error Text="UEDumper DMA requires the x64 platform and x64 MemProcFS runtime." />
  </Target>
  <Target Name="RequireDmaRuntime" BeforeTargets="ClCompile" Condition="'$(Platform)'=='x64'">
    <Error Condition="!Exists('$(ProjectDir)..\ThirdParty\MemProcFS\include\vmmdll.h') or !Exists('$(ProjectDir)..\ThirdParty\MemProcFS\include\leechcore.h') or !Exists('$(ProjectDir)..\ThirdParty\MemProcFS\bin\vmm.dll') or !Exists('$(ProjectDir)..\ThirdParty\MemProcFS\bin\leechcore.dll') or !Exists('$(ProjectDir)..\ThirdParty\MemProcFS\bin\FTD3XX.dll')"
           Text="The DMA runtime is incomplete (vmmdll.h, leechcore.h, vmm.dll, leechcore.dll and FTD3XX.dll are all required). Run:  powershell -ExecutionPolicy Bypass -File scripts\Fetch-MemProcFS.ps1" />
  </Target>
  <Target Name="DeployDmaRuntime" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <Copy SourceFiles="@(DmaRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(DmaRuntime)'!=''" />
    <Copy SourceFiles="$(ProjectDir)..\config.ini" DestinationFiles="$(OutDir)config.ini" Condition="!Exists('$(OutDir)config.ini')" />
    <Copy SourceFiles="$(ProjectDir)..\config.ini" DestinationFiles="$(OutDir)config.example.ini" SkipUnchangedFiles="true" />
  </Target>
